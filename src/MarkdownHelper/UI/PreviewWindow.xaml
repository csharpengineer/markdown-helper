<Window x:Class="MarkdownHelper.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown Helper" Width="980" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ShellBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionBtn}" Click="OnMinimize" AutomationProperties.Name="Minimize">
          <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
        </Button>
        <Button Style="{StaticResource CaptionBtn}" Click="OnMaximize" AutomationProperties.Name="Maximize">
          <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1"
                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button Style="{StaticResource CloseCaptionBtn}" Click="OnClose" AutomationProperties.Name="Close">
          <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
        <Image Source="{StaticResource LogoImage}" Width="18" Height="18" />
        <TextBlock Text="Markdown Helper" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </DockPanel>

    <!-- Toolbar -->
    <DockPanel Grid.Row="1" Margin="12,4,12,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ToggleButton x:Name="MarkdownSwitch" Style="{StaticResource Switch}" Content="Markdown" Checked="OnMarkdownSwitch" Unchecked="OnMarkdownSwitch"
                      AutomationProperties.Name="Show markdown" VerticalAlignment="Center" />
        <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings">
          <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.2" StrokeLineJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M8,1.2 L9,3.1 11.1,2.6 11.7,4.7 13.8,5.3 13.3,7.4 14.8,8.9 13.3,9.9 13.2,12.1 11,12.3 10,14.2 8,13.3 6,14.2 5,12.3 2.8,12.1 2.7,9.9 1.2,8.9 2.7,7.4 2.2,5.3 4.3,4.7 4.9,2.6 7,3.1 Z M10.2,8 A2.2,2.2 0 1 0 5.8,8 A2.2,2.2 0 1 0 10.2,8 Z" />
        </Button>
      </StackPanel>
      <Border HorizontalAlignment="Left" Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1" CornerRadius="8" Padding="2,3">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="EditMode" Style="{StaticResource SelectorItem}" Content="Edit" GroupName="Mode" Checked="OnModeChanged" />
          <RadioButton x:Name="RemoveMode" Style="{StaticResource SelectorItem}" Content="Remove pieces" GroupName="Mode" Checked="OnModeChanged" />
        </StackPanel>
      </Border>
    </DockPanel>

    <!-- Work area -->
    <Grid Grid.Row="2" Margin="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SourceColumn" Width="0" />
        <ColumnDefinition x:Name="GapColumn" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" x:Name="SourcePane" Background="{DynamicResource SourceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <TextBox x:Name="Source" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                 CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" Padding="14" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False"
                 TextChanged="OnSourceChanged" AutomationProperties.Name="Markdown source" />
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1" CornerRadius="8">
        <Grid>
          <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                       CaretBrush="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                       VerticalScrollBarVisibility="Auto" IsUndoEnabled="False" AcceptsTab="False" IsDocumentEnabled="False"
                       TextChanged="OnEditorChanged" SizeChanged="OnEditorSized" AutomationProperties.Name="Formatted text" />

          <ScrollViewer x:Name="PiecesScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <ItemsControl x:Name="PiecesList" Margin="22,18" MaxWidth="720" Focusable="False" />
          </ScrollViewer>

          <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
            <Image Source="{StaticResource LogoImage}" Width="36" Height="36" Opacity="0.9" />
            <TextBlock Text="Copy some markdown, or paste it here" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock x:Name="EmptyDetail" Margin="0,4,0,0" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="3" Margin="12,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="UndoButton" Style="{StaticResource Btn}" Click="OnUndo" IsEnabled="False" AutomationProperties.Name="Undo">
          <StackPanel Orientation="Horizontal">
            <Path Width="14" Height="14" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M4.5,2 L1.8,4.7 L4.5,7.4 M2,4.7 H8.2 A3.8,3.8 0 0 1 8.2,12.3 H5" />
            <TextBlock Text="Undo" Margin="6,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="CopyButton" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Click="OnCopy" Content="Copy" IsDefault="False" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" />
        <TextBlock x:Name="StatusText" Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>

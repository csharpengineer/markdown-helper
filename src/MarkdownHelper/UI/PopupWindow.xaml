<Window x:Class="MarkdownHelper.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown copied" Width="320" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border Margin="12" CornerRadius="9" BorderThickness="1" Background="{DynamicResource LayerBrush}"
          BorderBrush="{DynamicResource StrokeStrongBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="2" />
      </Grid.RowDefinitions>
      <StackPanel Margin="13,11,10,13">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="24" Height="24" Click="OnDismiss" AutomationProperties.Name="Dismiss">
            <Path Data="M0.5,0.5 L8.5,8.5 M8.5,0.5 L0.5,8.5" StrokeThickness="1" Width="9" Height="9"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Image Source="{StaticResource LogoImage}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="Markdown copied" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="Snippet" Margin="26,2,6,11" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        <UniformGrid Columns="2" Margin="0,0,3,0">
          <Button Style="{StaticResource PrimaryBtn}" Content="Preview" Height="30" Margin="0,0,4,0" MinWidth="0" Padding="6,0" Click="OnPreview" />
          <Button x:Name="CopyFormattedButton" Style="{StaticResource Btn}" Content="Copy formatted" Height="30" Margin="4,0,0,0" Padding="6,0" Click="OnCopyFormatted" />
        </UniformGrid>
      </StackPanel>
      <Border Grid.Row="1" x:Name="Life" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5" CornerRadius="0,0,1,9">
        <Border.RenderTransform>
          <ScaleTransform x:Name="LifeScale" ScaleX="1" />
        </Border.RenderTransform>
      </Border>
    </Grid>
  </Border>
</Window>

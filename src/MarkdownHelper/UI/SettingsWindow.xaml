<Window x:Class="MarkdownHelper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown Helper settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ShellBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Margin" Value="14,6" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </Window.Resources>

  <StackPanel>
    <DockPanel Height="38">
      <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionBtn}" Click="OnClose" AutomationProperties.Name="Close"
              WindowChrome.IsHitTestVisibleInChrome="True">
        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" StrokeThickness="1" Width="10" Height="10"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
        <Image Source="{StaticResource LogoImage}" Width="18" Height="18" />
        <TextBlock Text="Settings" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </DockPanel>

    <StackPanel Margin="12,2,12,12">
      <Border Style="{StaticResource Group}">
        <StackPanel Margin="0,0,0,3">
          <TextBlock Text="When markdown is copied" FontWeight="SemiBold" Margin="14,11,0,4" />
          <RadioButton x:Name="ModePopup" Style="{StaticResource OptionRow}" GroupName="Notify" Checked="OnNotifyChanged">
            <StackPanel>
              <TextBlock Text="Show a small popup" />
              <TextBlock Text="Fades on its own and never takes focus" Style="{StaticResource Sub}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ModeTray" Style="{StaticResource OptionRow}" GroupName="Notify" Checked="OnNotifyChanged">
            <StackPanel>
              <TextBlock Text="Only mark the tray icon" />
              <TextBlock Text="A dot appears, and you click when you're ready" Style="{StaticResource Sub}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ModeOpen" Style="{StaticResource OptionRow}" GroupName="Notify" Checked="OnNotifyChanged">
            <StackPanel>
              <TextBlock Text="Open the preview window" />
              <TextBlock Text="Goes straight to the window every time" Style="{StaticResource Sub}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ModeShortcut" Style="{StaticResource OptionRow}" GroupName="Notify" Checked="OnNotifyChanged">
            <StackPanel>
              <TextBlock Text="Shortcut only" />
              <TextBlock Text="Stops watching, so nothing happens until you ask" Style="{StaticResource Sub}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Group}">
        <DockPanel Style="{StaticResource Row}">
          <Button x:Name="HotkeyButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OnRecordHotkey" PreviewKeyDown="OnHotkeyKey"
                  LostKeyboardFocus="OnHotkeyLostFocus" Padding="10,0" AutomationProperties.Name="Change shortcut">
            <ItemsControl x:Name="HotkeyKeys" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,1,1,2"
                          CornerRadius="5" Padding="8,1" Margin="2,0">
                    <TextBlock Text="{Binding}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Button>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Shortcut to open the preview" />
            <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Sub}" Visibility="Collapsed" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Group}">
        <DockPanel Style="{StaticResource Row}">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconBtn}" Width="26" Height="26" Click="OnSecondsDown" AutomationProperties.Name="Fewer seconds">
              <TextBlock Text="&#x2212;" FontSize="14" />
            </Button>
            <TextBlock x:Name="SecondsText" Width="76" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Style="{StaticResource IconBtn}" Width="26" Height="26" Click="OnSecondsUp" AutomationProperties.Name="More seconds">
              <TextBlock Text="+" FontSize="14" />
            </Button>
          </StackPanel>
          <TextBlock Text="Popup stays for" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Group}">
        <StackPanel Margin="14,10">
          <TextBlock Text="Ignore copies from" />
          <WrapPanel x:Name="IgnoreChips" Margin="0,7,0,0" />
          <DockPanel x:Name="AddRow" Margin="0,6,0,0" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="28" Content="Add" Margin="6,0,0,0" Click="OnAddApp" />
            <TextBox x:Name="AddAppBox" Height="28" Padding="6,4" Background="{DynamicResource LayerBrush}" Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" KeyDown="OnAddAppKey"
                     AutomationProperties.Name="App name" ToolTip="The app's process name, such as notepad" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Group}" Margin="0">
        <DockPanel Style="{StaticResource Row}">
          <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="OnStartupChanged" Unchecked="OnStartupChanged" VerticalAlignment="Center"
                        AutomationProperties.Name="Start with Windows" />
          <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</Window>
